# CCbuddy model providers are configured in Settings with the user's own API key.
# No CCbuddy account, OAuth, share service, or cloud API endpoint is required.

# Optional: a CCbuddy-owned remote-runtime release root for remote workspaces.
# Without this, local workspaces still work and remote runtime download is disabled.
# CCBUDDY_REMOTE_ASSET_CDN_BASE_URL=https://assets.example.com/ccbuddy/electron/releases/0.1.0

# Optional: a CCbuddy-owned HTTPS update manifest, supplied when packaging a release.
# CCBUDDY_UPDATE_MANIFEST_URL=https://updates.example.com/ccbuddy/latest.yml

# Optional: a local provider template for development or private deployment.
# CCBUDDY_BUILTIN_PROVIDER_CONFIG_FILE=/absolute/path/to/provider-template.json
