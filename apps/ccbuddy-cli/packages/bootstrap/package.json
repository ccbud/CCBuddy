{
  "name": "@ccbuddy/bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v4-replay": {
      "types": "./dist/ccbuddy-protocol-v4/replay.d.ts",
      "import": "./dist/ccbuddy-protocol-v4/replay.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@ccbuddy/adapters": "workspace:*",
    "@ccbuddy/contracts": "workspace:*",
    "@ccbuddy/core": "workspace:*",
    "@ccbuddy/dynamic-workflow": "workspace:*",
    "@ccbuddy/dynamic-workflow-runtime": "workspace:*",
    "@ccbuddy/i18n": "workspace:*",
    "@ccbuddy/provider": "workspace:*",
    "@ccbuddy/provider-node": "workspace:*",
    "@ccbuddy/shared": "workspace:*",
    "@ccbuddy/telemetry": "workspace:*",
    "diff": "^9.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yazl": "^3.3.1",
    "@ccbuddy/formal-proof": "workspace:*",
    "yazl": "^3.3.1"
  }
}
