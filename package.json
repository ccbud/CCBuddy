{
  "name": "ccbud",
  "version": "2.0.5",
  "description": "CC Buddy — a native macOS companion that proxies Claude Code to Anthropic-compatible providers and browses Claude Code and Codex session history.",
  "author": {
    "name": "loadchange",
    "email": "soocto@gmail.com"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccbud/ccbud.git"
  },
  "scripts": {
    "build:css": "tailwindcss --cwd src/renderer -i input.css -o styles.css",
    "sync:shared": "node -e \"require('fs').cpSync('src/shared','src/renderer/shared',{recursive:true})\"",
    "sync:clarity": "node scripts/sync-clarity.js",
    "release": "node scripts/release.js",
    "release:check": "node scripts/release-version.js check",
    "native:release:unsigned": "native/Scripts/validate-local-release.sh",
    "test": "node test/run.js",
    "update:cask": "node scripts/update-cask.js"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@tailwindcss/cli": "^4.3.1",
    "@tauri-apps/cli": "^2.11.3",
    "marked": "^18.0.5",
    "tailwindcss": "^4.3.1"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2"
  }
}
